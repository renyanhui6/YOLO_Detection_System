## 数据库配置
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=yolo_database
DB_CHARSET=utf8mb4

## 豆包 API 密钥
DOUBAO_API_KEY=replace-with-doubao-key

## MySQL 官方镜像需要的环境变量
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=yolo_database

## 可选：构建阶段代理与镜像源
HTTP_PROXY=
HTTPS_PROXY=
PIP_INDEX_URL=https://pypi.org/simple
PIP_DEFAULT_TIMEOUT=300
PIP_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu118
